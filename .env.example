# Anthropic API key — used by both the demo chatbot and the claim-extraction judge.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Postgres (matches docker-compose.yml defaults; no need to change for local dev)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=argo
POSTGRES_USER=argo
POSTGRES_PASSWORD=argo

# Models
CHAT_MODEL=anthropic/claude-sonnet-4-5
JUDGE_MODEL=anthropic/claude-haiku-4-5
