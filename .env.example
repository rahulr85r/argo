# Anthropic API key — used by both the demo chatbot and the claim-extraction judge.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Postgres (matches docker-compose.yml defaults; no need to change for local dev)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=argo
POSTGRES_USER=argo
POSTGRES_PASSWORD=argo

# Reference instant for time-windowed policy rules (`recent_payment`).
#
# The bundled demo dataset has fixed transaction dates (Feb–May 2026). Left on
# wall clock, those transactions slide out of the 90-day counterparty window as
# real time passes and the demo quietly stops demonstrating. "seed" pins the
# reference to the dataset so it stays correct indefinitely.
#
# PRODUCTION: leave this EMPTY. Real transactions are genuinely recent, and a
# pinned clock would stop stale relationships from ageing out of the graph.
REFERENCE_TIME=seed

# Models
# Haiku for chat — realistic for cost-optimized bank deployments, and (more
# importantly for the Phase 0 demo) it leaks on direct queries where Sonnet
# self-filters. Sonnet 4.6 is the safer prod default once Argo is in front.
CHAT_MODEL=anthropic/claude-haiku-4-5
JUDGE_MODEL=anthropic/claude-haiku-4-5

# Pluggable Protocols — each is "module.path:ClassName". Override any of
# these to plug in your own implementation (Okta entitlements, Bedrock LLM,
# Splunk audit, core-banking transaction source, etc). Defaults shown; see
# ADAPTERS.md for the full contracts and worked Okta/Bedrock/Splunk examples.
# ENTITLEMENT_ADAPTER=argo.entitlements:DbDerivedAdapter
# AUDIT_WRITER=argo.db.audit:PostgresAuditWriter
# LLM_CLIENT=argo.llm:LiteLlmClient
# VERIFIER=argo.verifier:LlmVerifier
# TRANSACTION_SOURCE=argo.db.queries:PostgresTransactionSource
